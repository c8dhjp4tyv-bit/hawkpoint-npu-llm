+# XDNA=1 reuses the stable resident-tensor ABI exposed in backend_cuda.h while
+# linking a native C++/XRT implementation. Unsupported operations return zero,
+# which is the ABI's documented signal for the C engine to use its CPU path.
+ifeq ($(XDNA),1)
+ifeq (,$(LINUX))
+$(error XDNA=1 is supported only on Linux)
+endif
+ifneq ($(filter 1,$(CUDA) $(HIP) $(CUDA_DLL) $(HIP_DLL)),)
+$(error choose XDNA=1 or a CUDA/HIP backend, not both)
+endif
+ifneq ($(COLI_ANS),0)
+$(error XDNA=1 does not support COLI_ANS)
+endif
+CFLAGS   += -DCOLI_CUDA -DCOLI_XDNA
+LDFLAGS  += -L$(XRT_ROOT)/lib64 -Wl,-rpath,$(XRT_ROOT)/lib64 -lxrt_coreutil -lstdc++
+CUDA_OBJ  = backend_xdna.o
+endif
+
