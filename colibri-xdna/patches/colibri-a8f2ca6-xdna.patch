@@ -740,6 +760,10 @@ shaders/%.spv: shaders/%.comp
 backend_loader.o: backend_loader.c backend_cuda.h compat.h .build-config
 	$(CC) $(CFLAGS) -c backend_loader.c -o $@
 
+backend_xdna.o: backend_xdna.cpp backend_cuda.h .build-config
