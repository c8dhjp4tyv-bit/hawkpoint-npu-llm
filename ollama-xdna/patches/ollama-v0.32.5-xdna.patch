+func appendGPULayerArgs(params []string, opts api.Options) []string {
+	xdna := os.Getenv("GGML_XDNA_XCLBIN") != ""
+	if opts.NumGPU > 0 {
+		params = append(params, "-ngl", strconv.Itoa(opts.NumGPU))
+		if xdna {
+			params = append(params, "--fit", "off")
+		}
+		return params
+	}
+	if opts.NumGPU == 0 {
+		params = append(params, "-ngl", "0")
+		if xdna {
+			params = append(params, "--fit", "off")
+		}
+		return params
+	}
+
+	// Avoid the automatic fit probe because XDNA1 permits one active context.
+	// Use the administrator's measured default, or the universally safe CPU
+	// placement; per-model num_gpu options still take precedence.
+	if xdna {
+		value := os.Getenv("OLLAMA_XDNA_GPU_LAYERS")
+		layers, err := strconv.Atoi(value)
+		if value == "" || err != nil || layers < 0 {
+			layers = 0
+		}
+		return append(params, "-ngl", strconv.Itoa(layers), "--fit", "off")
+	}
+
+	return params
+}
