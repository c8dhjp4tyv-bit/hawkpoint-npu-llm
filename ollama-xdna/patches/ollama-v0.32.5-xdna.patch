+func xdnaNPUComputePercent(size, sizeVRAM int64, family string, enabled bool) int {
+	if !enabled || size <= 0 || sizeVRAM < 0 || sizeVRAM > size {
+		return 0
+	}
+
+	// Qwen3-Coder 30B-A3B active linear MACs per transformer layer:
+	//   experts: gate + up + down = 3 * 8 * 2048 * 768
+	//   non-expert: Q/K/V/O projections + router
+	// The XDNA backend handles expert projections only for layers whose weights
+	// remain in host memory. GPU-resident layers continue to execute on CUDA.
+	if family == "qwen3moe" {
+		const expertMACs = 3.0 * 8.0 * 2048.0 * 768.0
+		const nonExpertMACs = 2048.0*4096.0 +
+			2.0*2048.0*512.0 +
+			4096.0*2048.0 +
+			2048.0*128.0
+		hostFraction := float64(size-sizeVRAM) / float64(size)
+		return int(math.Round(
+			100.0 * hostFraction * expertMACs / (expertMACs + nonExpertMACs),
+		))
+	}
+
+	return 0
+}
