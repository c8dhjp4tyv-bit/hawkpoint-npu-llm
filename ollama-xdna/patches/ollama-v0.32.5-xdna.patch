+func formatProcessor(m api.ProcessModelResponse) string {
+	if m.Size <= 0 || m.SizeVRAM < 0 || m.SizeVRAM > m.Size {
+		return "Unknown"
+	}
+
+	gpuPercent := int(math.Round(float64(m.SizeVRAM) / float64(m.Size) * 100))
+	gpuPercent = max(0, min(100, gpuPercent))
+	npuPercent := 0
+	if m.NPU {
+		npuPercent = max(0, min(100-gpuPercent, m.NPUPercent))
+	}
+	cpuPercent := 100 - gpuPercent - npuPercent
+
+	if npuPercent > 0 {
+		return fmt.Sprintf(
+			"%d%%/%d%%/%d%% CPU/GPU/NPU",
+			cpuPercent,
+			gpuPercent,
+			npuPercent,
+		)
+	}
+
+	var processor string
+	switch {
+	case gpuPercent == 0:
+		processor = "100% CPU"
+	case gpuPercent == 100:
+		processor = "100% GPU"
+	default:
+		processor = fmt.Sprintf(
+			"%d%%/%d%% CPU/GPU",
+			cpuPercent,
+			gpuPercent,
+		)
+	}
+	if m.NPU {
+		processor += " + NPU"
+	}
+	return processor
+}
